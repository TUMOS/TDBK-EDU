rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- SECURITY UTILITIES ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- TENANT DATA ---
    match /institutions/{tenantId} {
      match /{document=**} {
        // PERMISSIVE FOR DEBUGGING
        allow read, write: if true;
      }
    }
  }
}
